{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://aafobycbxitrgffqouro.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "enochtech-learning-hub",
      "version": "0.1.0",
      "title": "EnochTech learning hub"
    },
    "tools": [
      {
        "name": "list_study_plans",
        "title": "List study plans",
        "description": "List the signed-in learner's study plans with title, progress day and total days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max plans to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_plan_details",
        "title": "Get study plan details",
        "description": "Get a study plan's day-by-day material, progress and flashcard count.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "plan_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Study plan id from list_study_plans."
            }
          },
          "required": [
            "plan_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_study_plan",
        "title": "Create study plan",
        "description": "Create a new day-by-day study plan in the learner's KE-FORGE library from a topic and optional daily outlines.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Plan title, e.g. 'Organic Chemistry basics'."
            },
            "topic": {
              "type": "string",
              "minLength": 3,
              "maxLength": 4000,
              "description": "What the plan should teach."
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30,
              "description": "Number of study days."
            },
            "day_outlines": {
              "description": "Optional study notes per day; length should equal days.",
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "required": [
            "title",
            "topic",
            "days"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_flashcards",
        "title": "Add flashcards",
        "description": "Add flashcards (front/back) to one of the learner's study plans for spaced-repetition review.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "plan_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Study plan id."
            },
            "cards": {
              "minItems": 1,
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "front": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "back": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "day": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  }
                },
                "required": [
                  "front",
                  "back"
                ]
              },
              "description": "Flashcards to add."
            }
          },
          "required": [
            "plan_id",
            "cards"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "search_community_commons",
        "title": "Search Community Commons",
        "description": "Search study plans published to the KE-FORGE Community Commons by keyword or subject.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Keyword in the title or description.",
              "type": "string",
              "maxLength": 100
            },
            "subject": {
              "description": "Subject filter, e.g. Science, Mathematics, Medicine.",
              "type": "string",
              "maxLength": 60
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "fork_community_plan",
        "title": "Fork community plan",
        "description": "Copy a Community Commons study plan (material and flashcards) into the learner's own library.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "publication_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Publication id from search_community_commons."
            }
          },
          "required": [
            "publication_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
